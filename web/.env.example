NEXT_PUBLIC_POLLAR_API_KEY=your_pollar_api_key_here
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Soroban escrow contract. After deploying a new WASM build
# (see contracts/corridor_escrow), paste the contract address here.
# The settlement adapter (src/lib/stellar.ts) reads this at runtime.
NEXT_PUBLIC_CONTRACT_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM

# Paystack (sandbox)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# Exchange rates (for demo)
NGN_USD_RATE=0.00062
BOB_USD_RATE=6.90
